{
  "id": "moodle",
  "version": "1.0.0",
  "display_name": "Moodle",
  "capabilities": {
    "import_course": true,
    "search_catalog": true,
    "requires_auth": true,
    "content_types": ["theory", "quiz", "video"]
  },
  "entrypoints": {
    "health": "importer:health",
    "import": "importer:import_course",
    "search": "importer:search_remote",
    "list_catalog": "importer:list_catalog"
  }
}
