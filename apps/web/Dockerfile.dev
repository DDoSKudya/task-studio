# syntax=docker/dockerfile:1.7
FROM node:22-alpine

WORKDIR /app/apps/web

RUN apk add --no-cache libc6-compat wget \
    && apk upgrade --no-cache

COPY apps/web/package.json apps/web/package-lock.json ./
COPY packages/editor-core /app/packages/editor-core

RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY apps/web/ .
RUN chmod +x docker-entrypoint.dev.sh \
    && npm run postinstall

ENV HOST=0.0.0.0
ENV PORT=3000
ENV NUXT_TYPE_CHECK=false
ENV NUXT_DEVTOOLS=true
ENV NUXT_SKIP_ESLINT=true
ENV NUXT_TELEMETRY_DISABLED=1
ENV NUXT_PUBLIC_API_BASE=/api
ENV API_BASE_INTERNAL=http://studio-api:8000
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=40s \
    CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["./docker-entrypoint.dev.sh"]
