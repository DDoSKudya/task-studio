COMPOSE_PROJECT_NAME=task-studio
TZ=UTC

POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio
DATABASE_URL=postgresql+asyncpg://studio:studio@postgres:5432/studio

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://studio:studio@rabbitmq:5672/

SECRETS_MASTER_KEY=change-me-base64-32-bytes
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_HOURS=168
COOKIE_SECURE=false
AUTH_SERVICE_URL=http://auth:8001

LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=

ORCHESTRATOR_MODE=balancing
PACK_MAX_UPLOAD_MB=500
