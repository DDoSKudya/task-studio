COMPOSE_PROJECT_NAME=task-studio
TZ=UTC

# Memory limits (SoT: deploy/profiles.json → compose_env). Overrides optional.
MEM_LIMIT_DB=1024m
MEM_LIMIT_CACHE=512m
MEM_LIMIT_BROKER=512m
MEM_LIMIT_SEARCH=1024m
MEM_LIMIT_ANALYTICS_DB=2048m
MEM_LIMIT_HEAVY_ML=8192m
MEM_LIMIT_CODE_RUNNER=2048m
MEM_LIMIT_LSP=1024m

POSTGRES_USER=studio
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=studio
DATABASE_URL=postgresql+asyncpg://studio:CHANGE_ME@postgres:5432/studio

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://studio:CHANGE_ME@rabbitmq:5672/

# Заполняются scripts/install.sh|install.ps1 (32 байта в Base64 и случайный JWT / system token).
SECRETS_MASTER_KEY=
JWT_SECRET=
JWT_EXPIRE_HOURS=12
# Dev/local: 1 разрешает слабый JWT и пустой system token на orchestrator/auth.
# Complete attempt/lab и analytics /events всегда требуют валидный ORCHESTRATOR_SYSTEM_TOKEN.
ALLOW_INSECURE_DEFAULTS=1
APP_ENV=development
COOKIE_SECURE=false
# Host port for nginx edge (browser → Task Studio). Default 80; launcher picks a free
# loopback port if 80 is taken (common on Windows: IIS, Skype, VPN, antivirus).
TASK_STUDIO_HTTP_PORT=80
# Full UI URL for shortcuts / browser open. Leave empty to derive from HTTP port.
# TASK_STUDIO_UI_URL=http://localhost
# Probe URL for readiness (must hit Task Studio, not a foreign listener on :80).
# TASK_STUDIO_UI_PROBE_URL=http://127.0.0.1/api/health
# Если UI открыт по https (TASK_STUDIO_UI_URL), install/start выставит COOKIE_SECURE=true.
AUTH_SERVICE_URL=http://auth:8001
CATALOG_SERVICE_URL=http://catalog:8002
MEDIA_SERVICE_URL=http://media:8009
SESSIONS_SERVICE_URL=http://sessions:8003
GRADING_SERVICE_URL=http://grading:8004
PISTON_URL=http://piston:2000

MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=studio
# Presigned URL TTL if/when used (clamped 60–900s). Media API serves via auth + users/{id}/ keys.
MINIO_PRESIGN_TTL_SECONDS=900
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=

ORCHESTRATOR_MODE=balancing
ORCHESTRATOR_SYSTEM_TOKEN=
ORCHESTRATOR_SERVICE_URL=http://orchestrator:8011
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
DOCKER_GID=988
TUTOR_SERVICE_URL=http://tutor:8006
# Empty = use Ollama at OLLAMA_URL; set to override default OpenAI-compatible base.
TUTOR_DEFAULT_PROVIDER_URL=
# Reader proxy for antibot pages (Jina). Empty disables fallback.
ARTICLE_FETCH_READER_URL=https://r.jina.ai
OLLAMA_URL=http://ollama:11434
# Tutoring default: llama3.2 works, but for Russian prefer qwen2.5:3b or qwen2.5:7b
# (pull: docker compose exec ollama ollama pull qwen2.5:3b).
OLLAMA_MODEL=qwen2.5:3b
# auto | gpu | cpu — launcher picks profile from hardware when auto
OLLAMA_ACCELERATOR=auto
OLLAMA_PROFILE=
OLLAMA_TASK_ROUTING=true
# Per-contour models when routing is on (chat/hints/grade vs course build)
OLLAMA_MODEL_CHAT=
OLLAMA_MODEL_COURSE=
OLLAMA_MODEL_POLISH=
OLLAMA_MODEL_EMBED=nomic-embed-text
OLLAMA_REQUEST_RETRIES=3
OLLAMA_MAX_PARALLEL=1
# Context: larger = better course quality, slower on CPU (KV grows with num_ctx).
# Prefer GPU offload / smaller model over starving prompts with 2k ctx.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_CTX_COMPACT=4096
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_READ_TIMEOUT_SECONDS=720
# 24h or -1 = keep model loaded during long course builds
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# GPU host: compose -f deploy/docker-compose.yml -f deploy/docker-compose.ollama-gpu.yml
# Then verify: docker compose exec ollama nvidia-smi / ollama ps (GPU layers loaded).
# Topic bundles: theory → quiz → practice per chapter (interleaved manifest)
COURSE_TOPIC_BUNDLES=true
# Incomplete course builds (checkpoint/resume) on disk volume
COURSE_BUILDS_ROOT=/data/course-builds
COURSE_BUILD_TTL_DAYS=30
TUTOR_RATE_LIMIT_PER_MINUTE=30
# Grading fallback: when Stepik/API/local tests unavailable, call tutor LLM grade endpoint
LLM_GRADE_ENABLED=true
LLM_GRADE_MIN_CONFIDENCE=0.65
# OpenAI-compatible Cursor adapter (settings → Tutor → Cursor).
# Point provider URL to http://cursor-proxy:8015/v1 and paste a Cursor API key.
CURSOR_API_BASE=https://api.cursor.com
CURSOR_PROXY_TIMEOUT_SECONDS=180
CURSOR_PROXY_CLEANUP_AGENTS=true
INTEGRATIONS_SERVICE_URL=http://integrations:8005
# Optional: one OAuth app for the whole Task Studio deployment (password grant).
# Create at https://stepik.org/oauth2/applications/ while logged into Stepik:
# Client type = Confidential (or Public), Grant = Resource owner password-based.
# Learners only enter their Stepik email + password in Settings — not these keys.
STEPIK_CLIENT_ID=
STEPIK_CLIENT_SECRET=
SEARCH_SERVICE_URL=http://search:8007
ANALYTICS_SERVICE_URL=http://analytics:8008
ANALYTICS_EVENTS_QUEUE=analytics.events
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DATABASE=analytics
MEILISEARCH_URL=http://meilisearch:7700
# Обязателен для Meili (compose → MEILI_MASTER_KEY). install генерирует; пусто только если ALLOW_INSECURE_DEFAULTS.
MEILISEARCH_KEY=CHANGE_ME
LSP_PYRIGHT_HOST=lsp-pyright
LSP_TYPESCRIPT_HOST=lsp-typescript
LSP_GOPLS_HOST=lsp-gopls
LSP_SQLS_HOST=lsp-sqls
PACK_MAX_UPLOAD_MB=500
# true = lab checks skipped (honest fail + message). Set false after Docker CLI works in lab-runner.
LAB_RUNNER_DRY_RUN=true
LAB_DEFAULT_TIMEOUT_SECONDS=120
GRADING_JOBS_QUEUE=grading.jobs
LAB_JOBS_QUEUE=lab.jobs
# Pin heavy images (override to bump). Piston upstream often only publishes :latest.
OLLAMA_IMAGE=ollama/ollama:0.11.11
PISTON_IMAGE=ghcr.io/engineer-man/piston:latest

# CI image publish only (not used by local compose runtime)
DOCKER_REGISTRY=ghcr.io/your-org
DOCKER_USERNAME=
DOCKER_PASSWORD=
