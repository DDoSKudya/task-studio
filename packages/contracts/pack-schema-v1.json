{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-studio/schemas/pack/v1",
  "title": "Task Studio Pack Manifest v1",
  "type": "object",
  "required": ["schema_version", "id", "version", "title", "topics", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "locale": { "type": "string" },
    "source": { "type": "object" },
    "defaults": { "type": "object" },
    "policies": { "type": "object" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "phases"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "phases": { "type": "object" }
        }
      }
    },
    "course_assess": { "type": "object" },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": ["theory", "video", "quiz", "code", "lab"]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
