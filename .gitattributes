# Shell scripts must stay LF — CRLF breaks shebang/entrypoint on Linux containers (Docker Desktop).
*.sh text eol=lf
**/docker-entrypoint.sh text eol=lf

# Windows PowerShell 5.1 only treats UTF-8 as UTF-8 when a BOM is present.
# Keep LF in the repo; BOM is part of the file content (do not strip on checkout).
*.ps1 text eol=lf
