# Product plan (local operating docs; not published with the app)
.plan/

# ---------------------------------------------------------------------------
# Environment & secrets — never commit credentials or private keys
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
!**/*.example.env

# Key material / cert dumps (not source modules named *secret*)
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# Credential dumps (filenames), not code like credentialAutofill.ts
*credentials.json
*credentials.yml
*credentials.yaml
*credentials.toml
*.credentials
.credentials/
credentials/
secrets/
.secrets/
*.secret
*.secrets
*secret*.json
*secret*.yml
*secret*.yaml
*secret*.toml
*secret*.env
!*secret*.example*
!*credentials*.example*

# Cloud / SaaS CLI local auth (never repo)
.aws/
.gcloud/
.azure/
.kube/config
*.kubeconfig

